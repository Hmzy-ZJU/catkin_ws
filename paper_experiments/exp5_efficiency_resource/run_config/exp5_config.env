# Exp. 5 efficiency and resource usage configuration.

WS="${WS:-$HOME/catkin_ws}"
HARBOR_ROOT="${HARBOR_ROOT:-$WS/dataset_harbor}"
AQUATIC_ROOT="${AQUATIC_ROOT:-$WS/dataset_AquaticVision}"
EUROC_ROOT="${EUROC_ROOT:-$WS/dataset_EuRoc}"
AQUATIC_BASELINE="${AQUATIC_BASELINE:-0.11601670}"

# Paper setting: ROS online efficiency/resource testing.
DATASETS="${DATASETS:-harbor aquaticvision euroc}"
HARBOR_SEQUENCES="${HARBOR_SEQUENCES:-harbor_sequence_1 harbor_sequence_2 harbor_sequence_3 harbor_sequence_4 harbor_sequence_5 harbor_sequence_6 harbor_sequence_7}"
AQUATIC_SEQUENCES="${AQUATIC_SEQUENCES:-01 02 03 04 05 06 07 08 09}"
EUROC_SEQUENCES="${EUROC_SEQUENCES:-MH_01 MH_02 MH_03 MH_04 MH_05}"
SENSORS="${SENSORS:-mono stereo}"
UWIDVO_MODES="${UWIDVO_MODES:-ORB_SLAM3,IDPS,IDKD,IDVO}"
RUNS_PER_CASE="${RUNS_PER_CASE:-3}"

BAG_START="${BAG_START:-0}"
BAG_DURATION="${BAG_DURATION:-0}"
BAG_RATE="${BAG_RATE:-1.0}"
RUN_TIMEOUT="${RUN_TIMEOUT:-0}"
STARTUP_WAIT="${STARTUP_WAIT:-5}"
SAVE_TRAJ_TIMEOUT="${SAVE_TRAJ_TIMEOUT:-120}"

DO_BUILD="${DO_BUILD:-0}"
ENABLE_RVIZ="${ENABLE_RVIZ:-0}"
EVO_TIMEOUT="${EVO_TIMEOUT:-300}"
MIN_TRAJECTORY_POSES="${MIN_TRAJECTORY_POSES:-20}"

VOCAB="${VOCAB:-$WS/src/orb_slam3_ros/orb_slam3/Vocabulary/ORBvoc.txt.bin}"
PREPARE_AQUATIC_TOOL="${PREPARE_AQUATIC_TOOL:-$WS/tools/prepare_aquaticvision_euroc.py}"
RUNTIME_MODE="ros_online"
