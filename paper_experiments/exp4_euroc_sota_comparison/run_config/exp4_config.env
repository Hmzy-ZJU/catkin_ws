# Exp. 4 EuRoC SOTA comparison configuration.

WS="${WS:-$HOME/catkin_ws}"
EUROC_ROOT="${EUROC_ROOT:-$WS/dataset_EuRoc}"
EUROC_GT_ROOT="${EUROC_GT_ROOT:-$EUROC_ROOT/GT}"
EUROC_CACHE_ROOT="${EUROC_CACHE_ROOT:-$WS/offline_euroc_cache}"

# Paper setting: MH01-MH05, stereo-inertial, offline direct reading.
SEQUENCES="${SEQUENCES:-MH_01 MH_02 MH_03 MH_04 MH_05}"
SENSOR="${SENSOR:-stereo-inertial}"
UWIDVO_MODES="${UWIDVO_MODES:-ORB_SLAM3,IDPS,IDKD,IDVO}"
RUNS_PER_CASE="${RUNS_PER_CASE:-10}"

BAG_START="${BAG_START:-0}"
BAG_DURATION="${BAG_DURATION:-0}"
MAX_FRAMES="${MAX_FRAMES:-0}"
DO_BUILD="${DO_BUILD:-0}"
EVO_TIMEOUT="${EVO_TIMEOUT:-300}"
MIN_TRAJECTORY_POSES="${MIN_TRAJECTORY_POSES:-20}"
MIN_COMPLETENESS="${MIN_COMPLETENESS:-50.0}"

VOCAB="${VOCAB:-$WS/src/orb_slam3_ros/orb_slam3/Vocabulary/ORBvoc.txt.bin}"
BASE_CONFIG="${BASE_CONFIG:-$EXP_DIR/run_config/euroc_stereo_inertial.yaml}"
EXTRACT_TOOL="${EXTRACT_TOOL:-$WS/tools/extract_rosbag_to_euroc.py}"
RUNTIME_MODE="offline_direct"
