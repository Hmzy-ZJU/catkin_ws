<launch>

  <arg name="voc_file"
       default="$(find orb_slam3_ros)/orb_slam3/Vocabulary/ORBvoc.txt.bin"/>

  <arg name="settings_file"
       default="$(find orb_slam3_ros)/config/Monocular/cave/cave_off_00.yaml"/>

  <param name="use_sim_time" value="true" />

  <!-- 1) 把 /slave1/image_raw (compressed) 解压成 /camera/image_raw (raw) -->
  <node pkg="image_transport" type="republish" name="image_repub" output="screen"
        args="compressed in:=/slave1/image_raw raw out:=/camera/image_raw" />

  <!-- 2) ORB-SLAM3 Monocular -->
  <node name="orb_slam3"
        pkg="orb_slam3_ros"
        type="ros_mono"
        output="screen">

    <!-- 注意：这里不再 remap 图像话题，保持默认 /camera/image_raw -->
    <param name="voc_file"      type="string" value="$(arg voc_file)"/>
    <param name="settings_file" type="string" value="$(arg settings_file)"/>

    <param name="world_frame_id"  type="string" value="world"/>
    <param name="cam_frame_id"    type="string" value="camera"/>
    <param name="enable_pangolin" type="bool"   value="false"/>
  </node>

  <!-- 3) RViz 可选 -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find orb_slam3_ros)/config/orb_slam3_no_imu.rviz"
        output="screen" />

</launch>
