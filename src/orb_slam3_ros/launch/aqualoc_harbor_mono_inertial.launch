<launch>
  <arg name="voc_file"
       default="$(find orb_slam3_ros)/orb_slam3/Vocabulary/ORBvoc.txt.bin"/>
  <arg name="settings_file"
       default="$(find orb_slam3_ros)/config/Monocular-Inertial/Aqualoc_harbor.yaml"/>
  <arg name="image_topic" default="/camera/image_raw"/>
  <arg name="imu_topic" default="/rtimulib_node/imu"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="enable_pangolin" default="false"/>

  <param name="use_sim_time" value="$(arg use_sim_time)" />

  <node name="orb_slam3" pkg="orb_slam3_ros" type="ros_mono_inertial" output="screen">
    <remap from="/camera/image_raw" to="$(arg image_topic)"/>
    <remap from="/imu" to="$(arg imu_topic)"/>

    <param name="voc_file" type="string" value="$(arg voc_file)"/>
    <param name="settings_file" type="string" value="$(arg settings_file)"/>

    <param name="world_frame_id" type="string" value="world"/>
    <param name="cam_frame_id" type="string" value="camera"/>
    <param name="imu_frame_id" type="string" value="imu"/>
    <param name="enable_pangolin" type="bool" value="$(arg enable_pangolin)"/>
  </node>

  <node name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(find orb_slam3_ros)/config/orb_slam3_with_imu.rviz"
        output="screen" />
</launch>
